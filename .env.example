# ==============================================================================
# Lenny Growth Assistant - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate for your environment.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Backend & API Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# LLM Provider Configuration
# Supported options: 'ollama' (default / local), 'openai', 'anthropic'
LLM_PROVIDER=ollama

# Ollama Local LLM Configuration
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60

# Cloud LLM Provider: Google Gemini API (Free tier available via Google AI Studio)
# Obtain a free-tier API key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional legacy cloud keys (retained for backward compatibility)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Agent Runtime Configuration (Pi Coding Agent RPC)
AGENT_FRAMEWORK=pi_agent
PI_CODING_AGENT_DIR=.local/pi-agent
PI_AGENT_TIMEOUT_SECONDS=120
# PI_AGENT_EXECUTABLE=  # Optional manual override to pi binary (defaults to agent_runtime/node_modules/.bin/pi.cmd)
ESSAY_OUTLINE_TIMEOUT_SECONDS=180
ESSAY_SECTION_TIMEOUT_SECONDS=180
ESSAY_TOTAL_TIMEOUT_SECONDS=900

# Authentic Pi Evidence Capture (Opt-in, disabled by default)
# When set to true, genuine JSONL RPC stream events from Pi subprocess executions
# are sanitized and saved to the local git-ignored directory .local/pi-evidence/
PI_CAPTURE_EVENTS=false
PI_EVIDENCE_DIR=.local/pi-evidence

# PostgreSQL Database & Docker Container Configuration
# Parameters used by Docker Compose and the backend application
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_local_password
POSTGRES_DB=lenny_assistant
POSTGRES_PORT=5432

# Docker Compose Host Port Mappings
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Primary Application Database Connection URL (psycopg3 driver)
# When running locally outside Docker (e.g. dev server on Windows):
DATABASE_URL=postgresql+psycopg://postgres:replace_with_secure_local_password@127.0.0.1:5432/lenny_assistant

# Optional: Override Docker backend database connection.
# Leave unset to connect to the compose postgres container.
# If connecting Docker containers to an existing development database on the Windows host:
# DOCKER_DATABASE_URL=postgresql+psycopg://postgres:replace_with_secure_local_password@host.docker.internal:55432/lenny_assistant

# Isolated Integration Test Database URL (strictly separate from development database)
# Used only by test_postgres_integration.py to prevent destructive operations on development data
TEST_POSTGRES_URL=postgresql+psycopg://postgres:replace_with_secure_local_password@127.0.0.1:5432/lenny_assistant_test

# Database Connection Pool Settings (tuned for 8 GB RAM laptop)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Transcript Corpus Ingestion Configuration (Phase 3 Step 3.2A)
CORPUS_TRANSCRIPTS_DIR=.local/corpus/lennys-podcast-transcripts

# Embedding & Retrieval Settings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
# Initial hypothetical baseline; subject to empirical validation against benchmark queries
RETRIEVAL_SIMILARITY_THRESHOLD=0.70

# Mandatory Agent Framework Configuration
# The assessment requires either Pi Coding Agent (preferred) or Anthropic Claude Agent SDK.
# Direct Ollama / LLM calls alone do NOT satisfy the mandatory agent framework requirement.
# Options: 'pi_agent' (preferred), 'claude_sdk' (permissible only if implemented and validated)
AGENT_FRAMEWORK=pi_agent
PI_AGENT_HOST=localhost
PI_AGENT_PORT=9000

# ==============================================================================
# Lenny Growth Assistant - Docker Build Context Ignore List
#
# Prevents host-specific binaries, secrets, development logs, and huge raw
# datasets from bloating the Docker build contexts.
# ==============================================================================

# Version control
.git/
.gitignore

# Environment files and credentials (CRITICAL: never bake secrets into images)
.env
.env.*
!.env.example
*.pem
.local/*
!.local/pi-agent/
.pi/

# Python virtual environments, bytecode, and test caches
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js dependencies and caches (ensures clean npm ci inside containers)
**/node_modules/
**/dist/
**/build/
.npm/
.eslintcache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/

# Raw dataset and binary model weights (must not be baked into images)
transcripts_raw/
data/raw/
corpus/
.local/corpus/
models/
*.bin
*.onnx

# Agent transcripts, local databases, and temporary files
agent_transcripts/
*.sqlite3
*.db
.DS_Store
Thumbs.db
*.tmp
*.temp
.idea/
.vscode/
